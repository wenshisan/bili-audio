{
  "version": 1,
  "rules": [
    {
      "id": "leading_index",
      "type": "remove",
      "pattern": "^\\d{1,3}[.、．]\\s*",
      "enabled": true
    },
    {
      "id": "bracket_noise",
      "type": "remove",
      "pattern": "[【\\[(（「][^】\\])）」]*?(?:Hi-?Res|无损|FLAC|320K|DSD|APE|WAV|4K|60帧|HDR|杜比|中字|字幕|歌词|Official|MV|PV|Live|现场|演唱会|翻唱|cover|カバー|试听|录音棚|百万|纯享|完整版|官方|烟嗓|伴奏|片尾曲|片头曲|主题曲|影视)[^】\\])）」]*[】\\])）」]",
      "enabled": true
    },
    {
      "id": "bare_quality",
      "type": "remove",
      "pattern": "(?<![A-Za-z])(?:Hi-?Res|FLAC|DSD|APE|WAV)(?![A-Za-z])",
      "enabled": true
    },
    {
      "id": "bracket_quality",
      "type": "remove",
      "pattern": "[【\\[(（「](?:Hi-?Res|无损|FLAC|320K|DSD|APE|WAV)[^】\\])）」]*[】\\])）」]",
      "enabled": true
    },
    {
      "id": "bracket_remaster",
      "type": "remove",
      "pattern": "[【\\[(（「](?:Remaster|重制|重录|数字版)[^】\\])）」]*[】\\])）」]",
      "enabled": true
    },
    {
      "id": "bracket_version",
      "type": "remove",
      "pattern": "[【\\[(（「](?:Live|现场|演唱会|Official|MV|PV|剧场版)[^】\\])）」]*[】\\])）」]",
      "enabled": true
    },
    {
      "id": "no_lyrics",
      "type": "flag",
      "pattern": "伴奏|纯音乐|Instrumental|无人声|Off Vocal",
      "flag": "noLyrics"
    },
    {
      "id": "cover_flag",
      "type": "flag",
      "pattern": "翻唱|cover|カバー",
      "flag": "cover"
    },
    {
      "id": "sep_dash",
      "type": "split",
      "pattern": "\\s[-—–]\\s",
      "order": "title_artist",
      "priority": 10
    },
    {
      "id": "sep_slash",
      "type": "split",
      "pattern": "\\s[/／]\\s",
      "order": "title_artist",
      "priority": 9
    },
    {
      "id": "sep_pipe",
      "type": "split",
      "pattern": "\\s*[|｜]\\s*",
      "order": "title_artist",
      "priority": 9
    },
    {
      "id": "sep_underscore",
      "type": "split",
      "pattern": "_",
      "order": "title_artist",
      "priority": 7
    },
    {
      "id": "extract_quotes",
      "type": "extract",
      "pattern": "[《「『]([^》」』]+)[》」』]",
      "group": "title",
      "priority": 15
    }
  ]
}
